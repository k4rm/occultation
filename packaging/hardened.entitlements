<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements applied only on a real Developer ID signing pass (see
  build_installer.sh --sign-app). Notarisation requires the hardened runtime,
  and under the hardened runtime a process needs these two entitlements to
  reach the camera and the audio input at all — JUCE's own generated
  .entitlements files are empty dicts, which is fine for an ad-hoc local build
  but would leave the camera sources dead in a notarised one.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
